# ── Environment / secrets ────────────────────────────────────────────────
.env
.env.*
!.env.example

# Stray copies of a REAL env file that the dotted patterns above miss —
# e.g. backend/env.bak2, env.local, prod.env. These hold live API keys and
# database passwords; one `git add .` would publish them permanently.
env
env.*
*.env
!*.env.example

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ── Node / Next.js ───────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ── Editor / OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Local tooling ────────────────────────────────────────────────────────
.claude/
