# Frontend config — copy to `.env` for local dev (`npm run dev`).
# These are NEXT_PUBLIC_* so they are inlined into the client bundle at build time;
# for Docker/production the value is passed as a build arg instead (see deploy/).

# Base URL of the FastAPI backend, as reached from the browser. No trailing slash.
# The WebSocket URL is derived from this automatically (http -> ws).
NEXT_PUBLIC_API_URL=http://localhost:8000
