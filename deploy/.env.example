# ============================================================================
#  Zynaptrix Copilot — deployment env.  Copy to `.env` and fill in.
# ============================================================================

# ── Public URLs (as the BROWSER sees them — no trailing slash) ───────────────
# On a bare ECS instance with just a public IP, use http + the IP.
# With a domain + TLS (Caddy/Nginx), use https + the hostnames.
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8000
FRONTEND_URL=http://YOUR_SERVER_IP

# ── AI provider (Qwen via Alibaba Cloud DashScope, OpenAI-compatible) ────────
AI_API_KEY=sk-your-dashscope-key
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MODEL_CHAT=qwen-max
MODEL_CHAT_LIGHT=qwen-flash
MODEL_VISION=qwen-vl-max
MODEL_EMBEDDING=text-embedding-v4
EMBEDDING_DIM=2048

# ── Neon Postgres + pgvector ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/dbname?sslmode=require

# ── Cloudinary (blob storage) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── InfluxDB Cloud (optional — safe to leave blank for a demo) ──────────────
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=

# ── Internal wiring (leave as-is) ──────────────────────────────────────────
# The simulator pushes telemetry to the backend over the compose network.
API_URL=http://backend:8000
LOG_LEVEL=INFO
