# Environments / secrets.
# These patterns must stay broad: anything matching them is a real credential
# file, and `COPY . .` would bake it into a published image layer permanently.
.env
.env.*
!.env.example
env
env.*
*.env
!*.env.example
.venv
venv/
ENV/
env.bak/
venv.bak/

# Python compiled
__pycache__/
*.py[cod]
*$py.class

# IDEs
.idea/
.vscode/

# Build artifacts
build/
dist/
*.egg-info/

# Git
.git/
.gitignore

# Testing
.pytest_cache/
