# ============================================
# Zynaptrix Industrial Copilot - Backend Configuration
# ============================================
# Copy this file to .env and fill in your values

# ── AI Provider Configuration (Qwen via Alibaba Cloud DashScope) ──────────────
# Required for: diagnosis, PDF captioning, text embeddings.
# Uses DashScope's OpenAI-compatible endpoint — get a key from
# https://modelstudio.console.alibabacloud.com/ (Singapore/international region
# for the free trial quota; the separate "Global"/US-Virginia deployment has no
# free quota). To switch to a self-hosted vLLM/Ollama server later, just point
# AI_BASE_URL at it (e.g. http://localhost:11434/v1) and update the MODEL_* names
# — no code changes needed.
AI_API_KEY=sk-your-dashscope-api-key-here
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MODEL_CHAT=qwen-max
MODEL_CHAT_LIGHT=qwen-flash
MODEL_VISION=qwen-vl-max
MODEL_EMBEDDING=text-embedding-v4
EMBEDDING_DIM=2048

# ── PostgreSQL Database (with pgvector extension) ─────────────────────────────
# Required for: Machine registry, anomaly records, chat history, vector storage
# Format: postgresql://username:password@host:port/database
# Recommended: Neon (https://neon.tech) or Supabase for managed pgvector
DATABASE_URL=postgresql://user:password@localhost:5432/industrial_copilot

# ── InfluxDB Configuration ────────────────────────────────────────────────────
# Required for: High-frequency sensor telemetry storage (10Hz writes)
# Get these from: InfluxDB Cloud Console → API Tokens
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=your-influxdb-token-here
INFLUX_ORG=your-organization-name
INFLUX_BUCKET=sensor_data

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Service URLs & Sync Routing ───────────────────────────────────────────────
# API_URL: Used by simulator to push telemetry (default: http://127.0.0.1:8000)
# FRONTEND_URL: Used for Zero-Trust CORS configuration (default: http://localhost:3000)
API_URL=http://127.0.0.1:8000
FRONTEND_URL=https://gen-ai-framework-research-zynaptrix.vercel.app

# ── Optional: Model Configuration ─────────────────────────────────────────────
# Anomaly detection threshold (lower = more sensitive)
# ANOMALY_THRESHOLD=0.02

# Consecutive anomalies before escalation
# CONSECUTIVE_THRESHOLD=3

# ── Optional: Logging ─────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
